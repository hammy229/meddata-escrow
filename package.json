{
  "name": "meddata-escrow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "PAYPAL_MODE=mock next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx lib/db/seed.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "postman:gen": "tsx scripts/openapi/to-postman.ts && prettier --write postman/*.json",
    "demo": "node --import tsx --env-file-if-exists=.env.local scripts/happy-path.ts",
    "db:migrate": "node --import tsx --env-file-if-exists=.env.local scripts/db/migrate.ts",
    "db:check": "node --import tsx --env-file-if-exists=.env.local scripts/db/check.ts",
    "db:seed": "node --import tsx --env-file-if-exists=.env.local scripts/db/seed.ts",
    "db:configure": "node --import tsx --env-file-if-exists=.env.local scripts/db/configure.ts",
    "db:import-sqlite": "node --import tsx --env-file-if-exists=.env.local scripts/db/import-sqlite.ts",
    "mcp": "node --import tsx --env-file-if-exists=.env.local scripts/mcp-server.ts",
    "eval": "npm run eval:audit && npm run eval:retrieval && npm run eval:redteam",
    "eval:audit": "node --import tsx scripts/eval/audit.ts",
    "eval:retrieval": "node --import tsx --env-file-if-exists=.env.local scripts/eval/retrieval.ts",
    "eval:redteam": "node --import tsx scripts/eval/redteam.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.1",
    "@anthropic-ai/sdk": "^1.6.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
