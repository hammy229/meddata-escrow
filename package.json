{
  "name": "meddata-escrow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "PAYPAL_MODE=mock next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx lib/db/seed.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"app/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "postman:gen": "tsx scripts/openapi/to-postman.ts && prettier --write postman/*.json",
    "demo": "node --import tsx --env-file-if-exists=.env.local scripts/happy-path.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.0.0",
    "@anthropic-ai/sdk": "^1.0.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "yaml": "^2.9.1"
  }
}
