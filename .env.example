# meddata-escrow environment template.
# Copy to .env.local and fill in your own values. NEVER commit real secrets.

# --- PayPal (sandbox) ---
# From https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook id from the dashboard (Apps & Credentials -> your app -> Webhooks).
# Required to verify inbound PayPal webhooks; unset = every webhook is rejected.
# (Demo only: with PAYPAL_MODE=mock, a webhook is accepted iff it carries the
# header `x-mock-webhook: 1`. Never run mock mode on a public deployment.)
PAYPAL_WEBHOOK_ID=
# Exposed to the browser for the PayPal JS SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Hosted LLM API ---
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# --- Database ---
# SQLite for local dev; Postgres (e.g. on Render) in production.
DATABASE_URL=file:./data/dev.sqlite

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
