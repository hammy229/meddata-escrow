# meddata-escrow environment template.
# Copy to .env.local and fill in your own values. NEVER commit real secrets.

# --- PayPal (sandbox) ---
# From https://developer.paypal.com/dashboard/ -> Apps & Credentials -> Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Set to "mock" to run the whole escrow arc with no PayPal credentials
# (deterministic MOCK-* ids). Leave unset to call the sandbox for real.
PAYPAL_MODE=mock
# Webhook id from the dashboard (Apps & Credentials -> your app -> Webhooks).
# Required to verify inbound PayPal webhooks; unset = every webhook is rejected.
# (Demo only: with PAYPAL_MODE=mock, a webhook is accepted iff it carries the
# header `x-mock-webhook: 1`. Never run mock mode on a public deployment.)
PAYPAL_WEBHOOK_ID=
# Sandbox demo only: where `npm run demo -- --sandbox` sends the vendor payout
# (a sandbox account from the dashboard). Unset = the seeded demo address.
SANDBOX_PAYOUT_EMAIL=

# --- AI: Claude on Amazon Bedrock ---
# Opt-in. Unset = deterministic local fallbacks (keyword matcher, keyword
# query planner, rule-based privacy screen and sample check, scripted agent).
# Credentials come from the standard AWS chain (~/.aws or AWS_* env vars) and
# the account needs Claude model access enabled in the Bedrock console.
LLM_PROVIDER=
AWS_REGION=us-east-1
# Optional override; defaults to anthropic.claude-opus-5-5.
LLM_MODEL=

# --- Database ---
# SQLite is the local fallback. APP_DATABASE_URL takes precedence when set.
# Render supplies APP_DATABASE_URL automatically from its PostgreSQL resource.
# Use the host's PostgreSQL URL for local access (verified TLS by default).
APP_DATABASE_URL=
# verify-full (default), or require for Render's self-signed PRIVATE network.
# require still encrypts traffic but does not verify the app DB certificate.
APP_DATABASE_TLS_MODE=verify-full
# Optional PEM CA certificate for the app database.
APP_DATABASE_CA_CERT=
# Generate once with npm run db:configure. Keep stable across deployments.
CONNECTION_ENCRYPTION_KEY=
# Exact comma-separated provider database hostnames. Empty = sources disabled.
PROVIDER_DATABASE_HOSTS=
# Local PostgreSQL only: requires non-production mode and sslmode=disable.
PROVIDER_DATABASE_ALLOW_LOCAL=false
# Explicit opt-in for approved source hosts on RFC1918/private networks.
PROVIDER_DATABASE_ALLOW_PRIVATE=false
# SQLite via Node's built-in node:sqlite.
DATABASE_URL=file:./data/dev.sqlite

# --- App ---
# Absolute site URL for OpenGraph/Twitter share metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Outbound escrow webhooks (optional; e.g. a Zapier "Catch Hook" URL) ---
# When set, every escrow creation/transition is POSTed here as JSON
# { type: "escrow.transition", orderId, event, from, to, amountCents, datasetId, at }.
# Unset = disabled. Delivery is fire-and-forget (3s timeout).
OUTBOUND_WEBHOOK_URL=
# Shared secret: requests carry X-MedData-Signature: sha256=<hex HMAC-SHA256 of
# the raw body>. Unset = unsigned (demo only).
OUTBOUND_WEBHOOK_SECRET=

# Signed spending mandates (web app and local MCP server must share this).
MANDATE_SECRET=

# Bearer secret for POST /api/escrow/sweep (escrow deadlines). Unset turns it off.
ESCROW_SWEEP_SECRET=
