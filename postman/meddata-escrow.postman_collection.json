                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/billing",
              "host": ["{{baseUrl}}"],
              "path": ["api", "billing"]
            },
            "description": "Records a usage row at the server-set fee (`PER_QUERY_FEE_CENTS`, 50).\n`chargeCents` is accepted only as a confirmation; any other value is\n422. The order must grant data access, otherwise 409. This is where a\nreal PayPal per-query capture would fire (mocked).\n",
            "body": {
              "mode": "raw",
