    {
      "name": "Orders",
      "description": "Escrow lifecycle (PayPal authorize-then-capture) and order reads.",
      "item": [
        {
          "name": "List orders, read one order, or summarize earnings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"],
              "query": [
                {
                  "key": "id",
                  "value": "{{orderId}}",
                  "disabled": true,
                  "description": "Return a single order by id."
                },
                {
                  "key": "events",
                  "value": "1",
                  "disabled": true,
                  "description": "With `id`, also return the order's audit events (any value)."
                },
                {
                  "key": "summary",
                  "value": "1",
                  "disabled": true,
                  "description": "Return the earnings summary instead of rows (any value)."
                },
                {
                  "key": "status",
                  "value": "",
                  "disabled": true,
                  "description": "Filter the list by escrow state."
                },
                {
                  "key": "datasetId",
                  "value": "ds_cardio_synthea_v1",
                  "disabled": true,
                  "description": "Filter the list (or scope the summary) to one dataset."
                },
                {
                  "key": "buyerEmail",
                  "value": "",
                  "disabled": true,
                  "description": "Filter the list by buyer email."
                }
              ]
            },
            "description": "Reads orders from the DB (no PayPal). The query string picks the shape:\n\n- no `id` / `summary` → `{ orders: OrderRow[] }` (newest first),\n  optionally AND-filtered by `status`, `datasetId`, `buyerEmail`.\n- `?id=ord_..` → `{ order }`; add `&events=1` for `{ order, events }`\n  (the audit timeline, oldest first). 404 if unknown.\n- `?summary=1[&datasetId=..]` → `{ summary: OrderSummary }`, the vendor\n  earnings roll-up.\n"
          },
          "response": []
        },
        {
          "name": "Create an escrow order at the listed price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"newOrderId\", pm.response.json().orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Creates a PayPal Orders v2 order (`intent=AUTHORIZE`) and an `orders`\nrow in state `MATCHED`. The escrowed amount is **always** the dataset's\nlisted price; an optional `amount` (major units) is only a confirmation,\nand a mismatch is 422. In mock mode no PayPal call is made, but the row\nis still persisted with a `MOCK-ORDER-*` id.\n",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"datasetId\": \"{{datasetId}}\",\n  \"amount\": 49,\n  \"buyerEmail\": \"researcher@example.edu\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Advance an order through the escrow state machine",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            },
            "description": "Actions map to escrow events: `authorize` (MATCHED → AUTHORIZED),\n`deliver` (AUTHORIZED → DELIVERED), `capture` (DELIVERED → CAPTURED),\n`payout` (CAPTURED → PAID_OUT), `void` (AUTHORIZED → VOIDED),\n`dispute` (AUTHORIZED/DELIVERED → DISPUTED), and `resolve` with\n`resolution: capture | void` (DISPUTED → CAPTURED | VOIDED).\n\nThe stored row is the source of truth for the current state and PayPal\nids. The transition is validated **before** any PayPal call, so an\nillegal move never charges anyone and never writes (409).\n",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{newOrderId}}\",\n  \"action\": \"authorize\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
