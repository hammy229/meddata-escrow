    {
      "name": "Matching",
      "description": "Rank catalog datasets against a study description.",
      "item": [
        {
          "name": "Rank datasets for a study description",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
