            ],
            "url": {
              "raw": "{{baseUrl}}/api/match",
              "host": ["{{baseUrl}}"],
              "path": ["api", "match"]
            },
            "description": "Returns catalog datasets ranked by relevance to a plain-English study\ndescription, each enriched with its catalog title and listed price.\n\nPreview: the response gains `source` (`llm` when ranked by the model,\n`keyword` for the deterministic fallback), and the body may instead be\n`{ \"sampleCheck\": datasetId }` to run a sample-quality check on one\ndataset before buying.\n",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Heart disease cohort with cardiology encounters\"\n}",
              "options": {
